<svg xmlns="http://www.w3.org/2000/svg" width="500" height="500" viewBox="0 0 500 500">
  <defs>
    <radialGradient id="bgGlow" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#3d2e4e"/>
      <stop offset="60%" stop-color="#1b1426"/>
      <stop offset="100%" stop-color="#0f0b17"/>
    </radialGradient>
    <linearGradient id="goldAccent" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#f4c468"/>
      <stop offset="50%" stop-color="#dca854"/>
      <stop offset="100%" stop-color="#996e25"/>
    </linearGradient>
  </defs>
  
  <!-- 底色面板 -->
  <rect width="500" height="500" fill="url(#bgGlow)"/>
  
  <!-- 同心黄金纹路圆环 -->
  <circle cx="250" cy="250" r="210" fill="none" stroke="url(#goldAccent)" stroke-width="2" opacity="0.4"/>
  <circle cx="250" cy="250" r="180" fill="none" stroke="url(#goldAccent)" stroke-width="1" opacity="0.25"/>
  <circle cx="250" cy="250" r="150" fill="none" stroke="url(#goldAccent)" stroke-width="1.5" opacity="0.3"/>
  <circle cx="250" cy="250" r="100" fill="none" stroke="url(#goldAccent)" stroke-width="3" opacity="0.8"/>
  
  <!-- 复古黑胶 CD 图标 -->
  <text x="250" y="230" text-anchor="middle" font-family="serif" font-size="64" fill="#f4c468">💿</text>
  <text x="250" y="290" text-anchor="middle" font-family="'Playfair Display', Georgia, serif" font-size="28" font-weight="bold" fill="#f3eedf" letter-spacing="3">RETRO VINYL</text>
  <text x="250" y="325" text-anchor="middle" font-family="sans-serif" font-size="14" font-weight="600" fill="#a39baa" letter-spacing="2">HIGH FIDELITY AUDIO CD</text>
</svg>
